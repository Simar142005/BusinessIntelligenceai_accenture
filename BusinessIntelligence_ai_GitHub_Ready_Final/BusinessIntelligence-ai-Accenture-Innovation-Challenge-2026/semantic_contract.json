{
  "kpis": {
    "Gross Margin": {
      "definition": "(Revenue - Cost) / Revenue",
      "grain": "region-day / region-product-day",
      "baseline": "28-day rolling median",
      "materiality": "Absolute deviation >= 1.5 percentage points and business-impact flag",
      "drivers": [
        "supplier delay",
        "inventory pressure",
        "discounting",
        "volume",
        "product mix"
      ],
      "lineage": [
        "sales_finance.csv",
        "operations.csv"
      ],
      "access": {
        "Commercial Manager": "aggregated",
        "Data Analyst": "aggregated + product + source rows"
      }
    },
    "Revenue": {
      "definition": "Sum of transaction revenue",
      "grain": "region-day",
      "baseline": "28-day rolling median",
      "materiality": "Absolute percentage deviation >= 3%",
      "drivers": [
        "volume",
        "unit price",
        "discounting",
        "inventory"
      ],
      "lineage": [
        "sales_finance.csv"
      ],
      "access": {
        "Commercial Manager": "aggregated",
        "Data Analyst": "aggregated + product"
      }
    },
    "Volume": {
      "definition": "Sum of units sold",
      "grain": "region-product-day, aggregated to region-day",
      "baseline": "28-day rolling median",
      "materiality": "Absolute percentage deviation >= 5%",
      "drivers": ["demand", "discounting", "inventory availability", "seasonality"],
      "lineage": ["sales_finance.csv"],
      "access": {
        "Commercial Manager": "aggregated",
        "Data Analyst": "aggregated + product"
      }
    },
    "Discount Rate": {
      "definition": "Average observed discount rate",
      "grain": "region-day",
      "baseline": "28-day rolling median",
      "materiality": "Absolute percentage deviation >= 5%",
      "drivers": [
        "promotion",
        "pricing policy",
        "competition"
      ],
      "lineage": [
        "sales_finance.csv",
        "operations.csv"
      ],
      "access": {
        "Commercial Manager": "aggregated",
        "Data Analyst": "aggregated + product"
      }
    },
    "Inventory": {
      "definition": "Total inventory units",
      "grain": "region-day",
      "baseline": "28-day rolling median",
      "materiality": "Absolute percentage deviation >= 5%",
      "drivers": [
        "supplier delay",
        "demand",
        "replenishment"
      ],
      "lineage": [
        "operations.csv"
      ],
      "access": {
        "Commercial Manager": "aggregated",
        "Data Analyst": "aggregated + product"
      }
    }
  },
  "sources": {
    "sales_finance.csv": {
      "type": "structured",
      "grain": "region-product-day",
      "refresh": "hourly",
      "freshness": "2 hours"
    },
    "operations.csv": {
      "type": "structured",
      "grain": "region-day",
      "refresh": "30 min",
      "freshness": "30 minutes"
    },
    "business_events.csv": {
      "type": "unstructured",
      "grain": "event",
      "refresh": "daily/as-entered",
      "freshness": "1 day"
    }
  },
  "security": {
    "Commercial Manager": [
      "regional KPIs",
      "ranked drivers",
      "evidence summaries",
      "recommendations"
    ],
    "Data Analyst": [
      "all manager views",
      "product-level drill-down",
      "source rows",
      "lineage",
      "method details"
    ]
  }
}